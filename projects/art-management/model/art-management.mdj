        {
          "_type": "UMLConstraint",
          "_id": "0ffd59ca981858eb94aed3e32ef8bdb4",
          "_parent": {
            "$ref": "f55e0eb30be656fc9eebd79512707a38"
          },
          "name": "Shipping rules",
          "specification": "SHIPPING (USD per art piece)\nAll art: base 10.99. Drawing and Print: base only.\nSculpture: 10.99 + 0.20 * weightOunces.\nPainting: area = height * width (square inches).\narea <100: +5.99; 100<=area<=300: +10.99; area>300: +15.99.\nTransaction quote = sum of each art price + its shipping.",
          "constrainedElements": [
            {
              "$ref": "a50d53abd41a53e6b3503beebc24345c"
            }
          ]
        },
        {
          "_type": "UMLConstraint",
          "_id": "e80d2ebf28ac5186a90fe6652f394ec3",
          "_parent": {
            "$ref": "f55e0eb30be656fc9eebd79512707a38"
          },
          "name": "Completion contract",
          "specification": "COMPLETION RESPONSIBILITIES\nArtManager.completeTransaction(transactionId) locates the transaction,\nrejects missing/completed records, and checks EVERY art ID against inventory.\nAny failure leaves inventory and transaction unchanged. Prepare total/date\nbefore mutation; perform no file I/O in the commit.\nTransaction.completeTransaction() assigns its date and stored total once.\nOnly after successful completion does ArtManager remove all purchased art.\nValidation/commit is one non-interleaved in-memory operation.",
          "constrainedElements": [
            {
              "$ref": "f5a6c1e1b3395ab7a2ca42d022e1cf0b"
            }
          ]
        },
        {
          "_type": "UMLConstraint",
          "_id": "37615d9733ea548c9f9c84940f0341c0",
          "_parent": {
            "$ref": "f55e0eb30be656fc9eebd79512707a38"
          },
          "name": "Immutable art",
          "specification": "ART CONSTRUCTION AND IMMUTABILITY\nid is exactly 10 decimal digits; yearCreated is a year; description <=500 chars.\nAll common and subtype values are required; no Art setters.\nSubclass constructors pass inherited arguments to super.\nPainting/Drawing/Print category: history, portrait, genre, landscape, still life.\nPrint editionType: canvas, paper, photo. Styles/techniques/materials are open text.\nAll four calculateShippingCost(): double operations override Art.",
          "constrainedElements": [
            {
              "$ref": "a50d53abd41a53e6b3503beebc24345c"
            }
          ]
        },
        {
          "_type": "UMLConstraint",
          "_id": "08b4044fb2425fdc8030b8061027880e",
          "_parent": {
            "$ref": "f55e0eb30be656fc9eebd79512707a38"
          },
          "name": "Transaction lifecycle",
          "specification": "TRANSACTION AND CUSTOMER DATA\nUI supplies the unique transaction ID. Require Customer and >=1 Art.\ntransactionDate == null means incomplete. Only completion sets date/price.\nAfter completion: no edits/removal; date/price/ID have no public setters.\nCustomer values are mutable, but Transaction copies customer data on input/\noutput and protects its completed snapshot. Art-list and Date getters copy.\nThe five-argument constructor restores saved state without replaying a sale.\nText-file loading preserves both incomplete and completed transactions.\nArt IDs in artPieces are unique; duplicate additions fail before mutation.",
          "constrainedElements": [
            {
              "$ref": "68ec11333e9a5ed3a8927c09872d98eb"
            }
          ]
        },
        {
          "_type": "UMLConstraint",
          "_id": "2ef898f3b2055cf59c17c09ddae031e3",
          "_parent": {
            "$ref": "f55e0eb30be656fc9eebd79512707a38"
          },
          "name": "Relationship semantics",
          "specification": "RELATIONSHIPS AND EXCEPTIONS\nHollow diamonds denote shared aggregation at the whole. No exclusive\npart lifetime is specified, so no composition is invented.\nArt/Transaction may exist before manager admission; Art survives in sales.\nEach Transaction has exactly 1 Customer and at least 1 Art; either part may\nbe referenced by multiple transactions.\nInventory add/remove failures: InvalidArtOperationException.\nTransaction add/remove/edit failures: InvalidTransOperationException.\nCompletion failures: InvalidTransactionException. Messages include operation, ID, reason.",
          "constrainedElements": [
            {
              "$ref": "f5a6c1e1b3395ab7a2ca42d022e1cf0b"
            }
          ]
        }
      ]
    }
  ],
  "documentVersion": 1
}